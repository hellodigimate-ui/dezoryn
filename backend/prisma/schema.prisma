// Prisma Schema for Dezoryn Website CMS Backend Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  role          Role           @default(ADMIN)
  isActive      Boolean        @default(true)
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  refreshTokens RefreshToken[]
  mediaUploads  Media[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String
  folder       String   @default("General")
  cloudinaryId String?
  resourceType String   @default("image")
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("media")
}


model HeroSection {
  id               String   @id @default("default")
  badgeText        String   @default("DEZORYN 3.0 ENTERPRISE SUITE")
  badgeIcon        String   @default("Sparkles")
  mainHeading      String   @default("Autonomous Operations for")
  gradientHeading  String   @default("Modern Enterprises")
  description      String   @default("Dezoryn Technologies unifies ERP, CRM, and AI automation into a single intelligent operating platform. Streamline workflows, scale operations, and boost productivity.")
  primaryBtnText   String   @default("Explore Solution")
  primaryBtnLink   String   @default("/products")
  secondaryBtnText String   @default("Schedule Demo")
  secondaryBtnLink String   @default("/book-demo")
  statsCards       Json
  techTags         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("hero_section")
}

model NavItem {
  id          String   @id @default(cuid())
  label       String
  route       String
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  isHighlight Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("nav_items")
}

model Product {
  id                  String   @id @default(cuid())
  title               String
  subtitle            String   @default("")
  description         String
  icon                String   @default("Zap")
  gradient            String   @default("from-blue-600 to-cyan-500")
  features            Json     @default("[]")
  image               String?
  order               Int      @default(0)
  status              String   @default("active")
  category            String   @default("core")
  isEnabled           Boolean  @default(true)

  // Extended Marketplace & CMS attributes
  slug                String?  @default("")
  categoryLabel       String?  @default("")
  industry            String?  @default("")
  badge               String?  @default("")
  shortDesc           String?  @default("")
  price               String?  @default("")
  priceValue          Float?   @default(0)
  discount            Float?   @default(0)
  pricingType         String?  @default("subscription")
  pricingTiers        Json?    @default("[]")
  thumbnail           String?  @default("")
  coverPhoto          String?  @default("")
  gallery             Json?    @default("[]")
  videoUrl            String?  @default("")
  demoUrl             String?  @default("")
  documentation       String?  @default("")
  specifications      String?  @default("")
  integrations        Json?    @default("[]")
  platforms           Json?    @default("[]")
  rating              Float?   @default(4.9)
  reviewsCount        Int?     @default(0)
  customerReviews     Json?    @default("[]")
  aiPowered           Boolean? @default(false)
  apiAvailable        Boolean? @default(false)
  cloudNative         Boolean? @default(false)
  mobileApp           Boolean? @default(false)
  whatsAppIntegration Boolean? @default(false)
  isFeatured          Boolean? @default(false)
  isPopular           Boolean? @default(false)
  metaTitle           String?  @default("")
  metaDescription     String?  @default("")
  metaKeywords        String?  @default("")
  canonicalUrl        String?  @default("")
  screenshots         Json?    @default("[]")
  deployment          Json?    @default("[]")
  businessSizes       Json?    @default("[]")
  languages           Json?    @default("[]")
  countries           Json?    @default("[]")
  downloadsCount      Int?     @default(0)
  viewsCount          Int?     @default(0)
  demoClicks          Int?     @default(0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("products")
}

model PricingPlan {
  id           String   @id @default(cuid())
  name         String
  price        String   @default("0")
  description  String
  features     Json     @default("[]")
  buttonText   String   @default("Get Started")
  buttonUrl    String   @default("/book-demo")
  isHighlight  Boolean  @default(false)
  ribbon       String?
  colorTheme   String   @default("blue")
  order        Int      @default(0)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pricing_plans")
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  company     String   @default("")
  designation String   @default("")
  review      String
  rating      Int      @default(5)
  photo       String?
  order       Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("General")
  order       Int      @default(0)
  status      String   @default("active")
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

model Job {
  id               String    @id @default(cuid())
  title            String
  department       String
  location         String
  salary           String    @default("Competitive")
  experience       String    @default("Mid-Senior")
  employmentType   String    @default("Full-Time")
  description      String
  requirements     Json      @default("[]")
  responsibilities Json      @default("[]")
  status           String    @default("active")
  closingDate      DateTime?
  order            Int       @default(0)
  isEnabled        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("jobs")
}

