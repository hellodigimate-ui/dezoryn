model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String   // visitor | lead | demo_request | contact_form | page_view | conversion
  page        String   @default("/")
  source      String   @default("direct") // direct | google | linkedin | twitter | referral | email
  sessionId   String?
  userAgent   String?
  country     String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([page])
  @@map("analytics_events")
}

